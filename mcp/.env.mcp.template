# 🤖 MCP Configuration Environment Template
#
# INSTRUCTIONS:
# 1. Kopiere diese Datei: cp .env.mcp.template ~/.env.mcp
# 2. Editiere ~/.env.mcp und füge deine Token ein
# 3. Lade in deinem Shell-Profile: [ -f ~/.env.mcp ] && source ~/.env.mcp
#
# Sicherheit: Diese Datei sollte NIEMALS in Git committet werden!
# .env.mcp sollte in .gitignore sein!

# ============================================================
# � CONTEXT7 CONFIGURATION (Up-to-date Code Docs)
# ============================================================
# How to create: https://context7.com/dashboard
# Context7 fetches up-to-date library documentation for your prompts
# Free tier available, paid for higher rate limits
CONTEXT7_API_KEY="your-context7-api-key-here"

# ============================================================
# �🔐 GITHUB CONFIGURATION
# ============================================================
# How to create: https://github.com/settings/tokens/new
# Scopes: repo, gist, workflow (optional), read:org
# Type: ghp_ (Personal Access Token)
GITHUB_TOKEN="ghp_yourtoken123456789"

# ============================================================
# 🥁 GITLAB CONFIGURATION  
# ============================================================
# How to create: https://gitlab.com/-/user_settings/personal_access_tokens
# Scopes: api, read_repository, write_repository (optional)
# Type: glpat_ (Personal Access Token)
GITLAB_TOKEN="glpat_yourtoken123456789"

# GitLab Instance URL (default: https://gitlab.com)
# Falls selbstgehostet: https://gitlab.yourcompany.com
GITLAB_HOST="https://gitlab.com"

# ============================================================
# 🐳 DOCKER CONFIGURATION
# ============================================================
# macOS Standard (Docker Desktop):
DOCKER_HOST="unix:///var/run/docker.sock"

# Alternative (TCP connection):
# DOCKER_HOST="tcp://127.0.0.1:2375"

# Optional: Docker Registry Credentials
# DOCKER_REGISTRY_USERNAME="your-username"
# DOCKER_REGISTRY_PASSWORD="your-password"
# DOCKER_REGISTRY="docker.io"

# ============================================================
# 🏗️ TERRAFORM CONFIGURATION
# ============================================================
# Terraform Cloud Token
# How to create: https://app.terraform.io/app/settings/tokens
TF_CLOUD_TOKEN="xxxxxxxxxxxxxxxxxxxx"

# Terraform Cloud Organization
TF_CLOUD_ORGANIZATION="your-organization"

# Backend configuration (wenn nicht in Code hardcodiert)
# TF_BACKEND_CONFIG="-backend-config=key=xxx"

# Environment-spezifische Terraform Variablen
TF_VAR_environment="development"
TF_VAR_region="eu-central-1"
TF_VAR_project="dev-config"

# ============================================================
# ☸️ KUBERNETES CONFIGURATION
# ============================================================
# Default kubeconfig location wird automatisch erkannt
# Falls custom: 
KUBECONFIG="$HOME/.kube/config"

# Optional: Default Kubernetes Namespace
# KUBE_NAMESPACE="default"

# ============================================================
# 🗄️ DATABASE CONFIGURATION
# ============================================================
# PostgreSQL Connection String
# Format: postgresql://[user[:password]@][host][:port]/[dbname]
DATABASE_URL="postgresql://postgres:password@localhost:5432/dev_db"

# Optional: pgAdmin/Database UI Credentials
# DB_ADMIN_URL="http://localhost:5050"
# DB_ADMIN_USER="admin@admin.com"
# DB_ADMIN_PASSWORD="password"

# ============================================================
# ☁️ AWS CONFIGURATION
# ============================================================
# AWS Profile (Standard: "default")
AWS_PROFILE="default"

# AWS Region (Standard: eu-central-1, us-east-1, eu-west-1)
AWS_REGION="eu-central-1"

# AWS Credentials (falls nicht über ~/.aws/credentials)
# AWS_ACCESS_KEY_ID="AKIA############"
# AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: AWS Session Token (für Temporary Credentials)
# AWS_SESSION_TOKEN="xxxxxxxxxxxx"

# ============================================================
# 🔄 CI/CD & DEPLOYMENT
# ============================================================
# ArgoCD (falls verwendet)
# ARGOCD_SERVER="argocd.example.com"
# ARGOCD_AUTH_TOKEN="xxxxx"

# Jenkins (falls verwendet)
# JENKINS_URL="http://jenkins.example.com"
# JENKINS_USER="admin"
# JENKINS_TOKEN="xxxxxxxxxxxx"

# ============================================================
# 🔐 SECRETS MANAGEMENT
# ============================================================
# HashiCorp Vault (falls verwendet)
# VAULT_ADDR="http://vault.example.com:8200"
# VAULT_TOKEN="s.xxxxxxxxxxxx"
# VAULT_NAMESPACE="your-namespace"

# 1Password (falls CLI verwendet)
# OP_ACCOUNT="my.1password.com"

# ============================================================
# 📊 MONITORING & LOGGING (OPTIONAL)
# ============================================================
# Prometheus
# PROMETHEUS_URL="http://prometheus.example.com:9090"

# Grafana
# GRAFANA_URL="http://grafana.example.com:3000"
# GRAFANA_API_KEY="xxxxxxxxxxxx"

# Datadog (falls verwendet)
# DATADOG_API_KEY="xxxxxxxxxxxx"
# DATADOG_APP_KEY="xxxxxxxxxxxx"

# ============================================================
# 🌐 ALLGEMEINE KONFIGURATION
# ============================================================
# Development Environment
ENVIRONMENT="development"

# Log Level: debug, info, warn, error
MCP_LOG_LEVEL="info"

# Timeout für MCP Server (ms)
MCP_TIMEOUT="30000"

# Auto-reconnect bei Disconnect
MCP_AUTO_RECONNECT="true"
